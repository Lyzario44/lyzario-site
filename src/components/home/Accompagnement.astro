---
// « Ce que comprend l'accompagnement » : livrables sans tarif.
// Le périmètre et la proposition commerciale sont établis après l'audit offert.
import { site } from '../../data/site';
import { miseEnPlace, maintenance, hebergement, abonnementTechnique, propositionApresAudit } from '../../data/offre';
const { theme = 'dark', separee = false } = Astro.props as { theme?: 'dark' | 'light'; separee?: boolean };
---

<section
  class:list={['section', 'offre', `theme-${theme}`, { 'grid-bg': theme === 'dark', 'section-separee': separee }]}
  id="accompagnement"
  aria-labelledby="accompagnement-title"
>
  <div class="container">
    <p class="label">L’accompagnement</p>
    <h2 id="accompagnement-title" class="display display-lg offre-title">Ce que comprend <em>l’accompagnement</em></h2>

    <div class="offre-grille">
      <article
        class:list={['carte', 'carte-principale', theme === 'dark' ? 'theme-light' : 'theme-dark']}
        aria-labelledby="mise-en-place-title"
      >
        <h3 id="mise-en-place-title" class="display display-sm carte-titre">La mise en place</h3>
        <p class="carte-intro">Un système complet, construit autour de votre façon de travailler.</p>

        <ul class="sq-list carte-liste">
          {miseEnPlace.inclus.map((item) => <li>{item}</li>)}
        </ul>

        <p class="carte-note-principale">{hebergement} {miseEnPlace.horsPerimetre}</p>

        <div class="proposition">
          <p class="display display-sm proposition-texte">{propositionApresAudit}</p>
          <a class="btn btn-primary proposition-cta" href={site.bookingUrl} target="_blank" rel="noopener">
            {site.ctaAudit}<span class="sr-only"> (nouvel onglet)</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>
      </article>

      <article class="carte carte-suivi" aria-labelledby="suivi-title">
        <h3 id="suivi-title" class="display display-sm carte-titre">Et après&#8239;? Le suivi</h3>
        <p class="badge">Facultatif, sans engagement</p>
        <p class="suivi-quand">Les 30 premiers jours après la mise en ligne sont couverts par la stabilisation. Ensuite, le suivi mensuel est facultatif.</p>

        <!-- Ordinateur et tablette : liste visible -->
        <ul class="sq-list carte-liste suivi-liste suivi-liste-large">
          {maintenance.comprend.map((item) => <li>{item}</li>)}
        </ul>

        <!-- Mobile : liste repliée dans un élément natif (clavier et lecteurs d'écran inclus) -->
        <details class="suivi-details">
          <summary class="suivi-resume">
            <span>Voir le détail de la maintenance</span>
            <span class="suivi-icone" aria-hidden="true"></span>
          </summary>
          <ul class="sq-list carte-liste suivi-liste">
            {maintenance.comprend.map((item) => <li>{item}</li>)}
          </ul>
        </details>

        <p class="carte-note">
          Vous pouvez arrêter quand vous voulez&#8239;: votre outil continue de fonctionner. L’abonnement technique, lui, reste nécessaire pour que votre interface reste en ligne.
        </p>
      </article>
    </div>

    <aside class="abonnement" aria-labelledby="abonnement-title">
      <div class="abonnement-texte">
        <h3 id="abonnement-title" class="display display-sm">{abonnementTechnique.titre}</h3>
        <p class="abonnement-role">{abonnementTechnique.role}</p>
        <p class="abonnement-arret">{abonnementTechnique.siArret}</p>
      </div>
      <ul class="sq-list abonnement-points">
        {abonnementTechnique.points.map((point) => <li>{point}</li>)}
      </ul>
    </aside>

    <div class="propriete" aria-labelledby="propriete-title">
      <div class="propriete-texte">
        <h3 id="propriete-title" class="display display-md">Tout <em>vous appartient</em></h3>
        <p class="propriete-p">
          Vous n’êtes pas dépendant de Lyzario. Les comptes nécessaires au fonctionnement sont créés à votre nom, ou vous sont remis à la livraison&#8239;: je construis votre système chez vous, pas chez moi. Après paiement intégral, les éléments réalisés spécifiquement pour vous vous appartiennent.
        </p>
        <p class="propriete-p propriete-precision">
          Si notre collaboration s’arrête, vous gardez la main sur votre solution&#8239;: il vous revient alors de reprendre à votre charge les abonnements techniques nécessaires à son fonctionnement.
        </p>
      </div>
      <ul role="list" class="propriete-grille">
        {['Votre application', 'Vos données', 'Vos accès', 'Vos comptes'].map((el) => (
          <li class="propriete-case">
            <span class="propriete-sq" aria-hidden="true"></span>
            <span class="propriete-nom">{el}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .offre-title {
    margin-top: var(--space-4);
  }

  .offre-grille {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-3);
    align-items: stretch;
  }

  .carte {
    padding: clamp(20px, 4vw, 40px);
    border-radius: var(--radius-lg);
    background: var(--surface);
    border: 1px solid var(--border);
  }

  .carte-principale {
    box-shadow: 0 24px 60px -30px rgba(0, 0, 0, 0.6);
  }

  /* Sur fond clair, la carte principale passe en bleu nuit pour rester l'élément fort */
  .carte-principale.theme-dark {
    background: var(--nuit-900);
    border-color: var(--nuit-900);
    box-shadow: 0 24px 60px -30px rgba(15, 23, 42, 0.5);
  }

  .carte-titre {
    color: var(--fg);
  }

  .carte-intro {
    margin-top: var(--space-2);
    color: var(--fg-soft);
  }

  .badge {
    display: inline-block;
    margin-top: var(--space-3);
    padding: 5px 10px;
    border: 1px solid var(--accent);
    border-radius: var(--radius-xs);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .carte-liste {
    margin-top: var(--space-5);
    gap: var(--space-2);
  }

  .carte-principale .carte-liste > li {
    color: var(--fg);
  }

  .carte-note-principale {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--fg-soft);
  }

  .suivi-quand {
    margin-top: var(--space-3);
    color: var(--fg-soft);
  }

  .carte-note {
    margin-top: var(--space-5);
    padding-top: var(--space-4);
    border-top: 1px solid var(--border);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .suivi-details {
    margin-top: var(--space-4);
    border-top: 1px solid var(--border);
  }

  .suivi-resume {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 48px;
    font-weight: 500;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }

  .suivi-resume::-webkit-details-marker {
    display: none;
  }

  .suivi-icone {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .suivi-icone::before,
  .suivi-icone::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 1.5px;
    background: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .suivi-icone::after {
    transform: rotate(90deg);
  }

  .suivi-details[open] .suivi-icone::after {
    transform: rotate(0deg);
  }

  .suivi-details .carte-liste {
    margin-top: var(--space-1);
    padding-bottom: var(--space-4);
  }

  .carte-principale {
    display: flex;
    flex-direction: column;
  }

  .proposition {
    margin-top: auto;
    padding-top: var(--space-6);
    display: grid;
    gap: var(--space-4);
  }

  .proposition-texte {
    max-width: 24em;
    color: var(--fg);
  }

  .proposition-cta {
    justify-self: start;
  }

  .abonnement {
    margin-top: var(--space-4);
    padding: clamp(20px, 3vw, 32px);
    display: grid;
    gap: var(--space-4);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .abonnement-role {
    margin-top: var(--space-2);
    color: var(--fg-soft);
  }

  .abonnement-arret {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .abonnement-points {
    gap: var(--space-2);
    align-content: start;
  }

  .propriete-precision {
    margin-top: var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .propriete {
    margin-top: clamp(40px, 5vw, 64px);
    padding-top: clamp(32px, 4vw, 48px);
    border-top: 1px solid var(--border);
    display: grid;
    gap: var(--space-5);
  }

  .propriete-p {
    margin-top: var(--space-3);
    max-width: 34rem;
    color: var(--fg-soft);
  }

  .propriete-grille {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-2);
  }

  .propriete-case {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
  }

  .propriete-sq {
    width: 8px;
    height: 8px;
    background: var(--teal-500);
  }

  .propriete-nom {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--fg);
  }

  @media (max-width: 767px) {
    .suivi-liste-large {
      display: none;
    }

    .suivi-details + .carte-note {
      margin-top: 0;
    }
  }

  @media (min-width: 768px) {
    .suivi-details {
      display: none;
    }

    .propriete-grille {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  @media (max-width: 520px) {
    .proposition-cta {
      width: 100%;
    }
  }

  @media (min-width: 640px) {
    .carte-liste {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      column-gap: var(--space-5);
    }
  }

  @media (min-width: 768px) {
    .abonnement {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: var(--space-6);
      align-items: start;
    }
  }

  @media (min-width: 1024px) {
    .offre-grille {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-4);
    }

    .suivi-liste {
      grid-template-columns: 1fr;
    }

    .propriete {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      column-gap: var(--space-8);
      align-items: center;
    }
  }
</style>
