---
import { faq } from '../../data/faq';
import { site } from '../../data/site';
const { theme = 'light', separee = false } = Astro.props as { theme?: 'dark' | 'light'; separee?: boolean };
---

<section class:list={['section', 'faq', `theme-${theme}`, { 'grid-bg': theme === 'dark', 'section-separee': separee }]} id="faq" aria-labelledby="faq-title">
  <div class="container faq-inner">
    <div class="faq-tete">
      <p class="label">Questions fréquentes</p>
      <h2 id="faq-title" class="display display-lg faq-title">Ce qu’on me demande <em>souvent</em></h2>
      <p class="faq-contact">
        Une autre question&#8239;? Écrivez-moi à <a href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </div>

    <div class="faq-liste">
      {faq.map((item) => (
        <details class="faq-item" name="faq">
          <summary class="faq-question">
            <span>{item.question}</span>
            <span class="faq-icone" aria-hidden="true"></span>
          </summary>
          <p class="faq-reponse">{item.reponse}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq-inner {
    display: grid;
    gap: var(--space-5);
  }

  .faq-title {
    margin-top: var(--space-4);
    max-width: 10em;
  }

  .faq-contact {
    margin-top: var(--space-5);
    color: var(--fg-soft);
  }

  .faq-contact a {
    color: var(--accent);
    text-underline-offset: 3px;
  }

  .faq-liste {
    border-top: 1px solid var(--border);
  }

  .faq-item {
    border-bottom: 1px solid var(--border);
  }

  .faq-question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: 56px;
    padding: var(--space-3) 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.125rem);
    font-weight: 500;
    color: var(--fg);
    cursor: pointer;
    list-style: none;
  }

  .faq-question::-webkit-details-marker {
    display: none;
  }

  .faq-icone {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }

  .faq-icone::before,
  .faq-icone::after {
    content: '';
    position: absolute;
    left: 0;
    top: 6px;
    width: 14px;
    height: 1.5px;
    background: var(--accent);
    transition: transform var(--dur) var(--ease);
  }

  .faq-icone::after {
    transform: rotate(90deg);
  }

  .faq-item[open] .faq-icone::after {
    transform: rotate(0deg);
  }

  .faq-reponse {
    padding-bottom: var(--space-5);
    max-width: 44rem;
    color: var(--fg-soft);
  }

  @media (min-width: 1024px) {
    .faq-inner {
      grid-template-columns: minmax(0, 4fr) minmax(0, 7fr);
      column-gap: var(--space-9);
      align-items: start;
    }

    .faq-tete {
      position: sticky;
      top: calc(var(--header-h) + var(--space-6));
    }
  }
</style>
