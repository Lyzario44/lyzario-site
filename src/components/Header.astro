---
import Logo from './Logo.astro';
import { site } from '../data/site';
import { navigation } from '../lib/contenus';

const nav = await navigation();
---

<header class="site-header theme-dark" data-header>
  <div class="container header-inner">
    <a class="header-logo" href="/" aria-label="Lyzario, retour à l'accueil">
      <Logo size={32} />
    </a>

    <nav class="header-nav" aria-label="Navigation principale">
      <ul role="list" class="nav-list">
        {nav.map((item) => (
          <li><a class="nav-link" href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </nav>

    <a class="btn btn-ghost btn-sm header-cta" href={site.bookingUrl} target="_blank" rel="noopener">
      {site.ctaAudit}<span class="sr-only"> (nouvel onglet)</span>
    </a>

    <button
      class="menu-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="menu-mobile"
      data-menu-toggle
    >
      <span class="sr-only" data-menu-label>Ouvrir le menu</span>
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <path class="menu-line menu-line-top" d="M4 8h16"></path>
        <path class="menu-line menu-line-bottom" d="M4 16h16"></path>
      </svg>
    </button>
  </div>

  <div class="menu-mobile" id="menu-mobile" data-menu hidden>
    <nav class="container" aria-label="Navigation mobile">
      <ul role="list" class="menu-mobile-list">
        {nav.map((item) => (
          <li><a class="menu-mobile-link" href={item.href} data-menu-link>{item.label}</a></li>
        ))}
      </ul>
      <a class="btn btn-primary menu-mobile-cta" href={site.bookingUrl} target="_blank" rel="noopener">
        {site.ctaAudit}<span class="sr-only"> (nouvel onglet)</span>
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.querySelector<HTMLElement>('[data-menu]');
  const label = document.querySelector<HTMLElement>('[data-menu-label]');

  if (toggle && menu && label) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      label.textContent = open ? 'Fermer le menu' : 'Ouvrir le menu';
      menu.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    };

    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));

    menu.querySelectorAll('[data-menu-link]').forEach((link) =>
      link.addEventListener('click', () => setOpen(false)),
    );

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    window.matchMedia('(min-width: 900px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto;
    z-index: 100;
    background: rgba(11, 18, 36, 0.72);
    backdrop-filter: blur(14px) saturate(140%);
    -webkit-backdrop-filter: blur(14px) saturate(140%);
    border-bottom: 1px solid var(--border);
  }

  .header-inner {
    height: var(--header-h);
    display: flex;
    align-items: center;
    gap: var(--space-6);
  }

  .header-logo {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .nav-list {
    display: flex;
    gap: var(--space-1);
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 var(--space-3);
    font-size: var(--text-sm);
    color: var(--fg-soft);
    text-decoration: none;
    transition: color var(--dur) var(--ease);
  }

  .nav-link:hover {
    color: var(--fg);
  }

  .menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    margin-right: calc(var(--space-2) * -1);
    background: none;
    border: 0;
    color: var(--fg);
    cursor: pointer;
  }

  .menu-line {
    transition: transform var(--dur) var(--ease);
    transform-origin: 12px 12px;
  }

  .menu-toggle[aria-expanded='true'] .menu-line-top {
    transform: translateY(4px) rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .menu-line-bottom {
    transform: translateY(-4px) rotate(-45deg);
  }

  .menu-mobile {
    border-top: 1px solid var(--border);
    background: var(--nuit-950);
    height: calc(100dvh - var(--header-h));
    overflow-y: auto;
  }

  .menu-mobile nav {
    padding-block: var(--space-5) var(--space-7);
    display: grid;
    gap: var(--space-6);
  }

  .menu-mobile-list {
    display: grid;
  }

  .menu-mobile-link {
    display: flex;
    align-items: center;
    min-height: 56px;
    font-family: var(--font-serif);
    font-size: 1.75rem;
    color: var(--fg);
    text-decoration: none;
    border-bottom: 1px solid var(--border);
  }

  .menu-mobile-cta {
    justify-self: start;
  }

  @media (max-width: 899px) {
    .header-nav,
    .header-cta {
      display: none;
    }

    .menu-toggle {
      display: inline-flex;
    }
  }

  :global(html.menu-open) {
    overflow: hidden;
  }
</style>
