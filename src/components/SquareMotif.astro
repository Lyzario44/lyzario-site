---
// Motif « au carré » de la charte : carrés épars qui rejoignent une grille 3 × 3,
// une seule cellule pleine turquoise en bas à droite. Décoratif.
interface Props {
  class?: string;
  /** Animation d'entrée : réservée au hero, seul mouvement automatique du site. */
  anime?: boolean;
}
const { class: className, anime = true } = Astro.props;

const cell = 64;
const gridX = 312;
const gridY = 104;
const cells = Array.from({ length: 9 }, (_, i) => ({
  x: gridX + (i % 3) * cell,
  y: gridY + Math.floor(i / 3) * cell,
}));

// Position finale (conforme à la charte) et décalage de départ pour l'animation d'entrée.
const scattered = [
  { x: 62, y: 96, s: 24, r: 14, dx: -40, dy: -24 },
  { x: 168, y: 44, s: 18, r: -12, dx: -24, dy: -36 },
  { x: 214, y: 150, s: 26, r: 24, dx: -52, dy: 8 },
  { x: 118, y: 226, s: 20, r: -20, dx: -36, dy: 28 },
  { x: 244, y: 262, s: 18, r: 36, dx: -20, dy: 40 },
  { x: 40, y: 312, s: 26, r: 10, dx: -44, dy: 32 },
  { x: 196, y: 334, s: 16, r: -16, dx: -28, dy: 44 },
];
---

<svg
  class:list={['motif', { 'motif-anime': anime }, className]}
  viewBox="0 0 520 400"
  aria-hidden="true"
  focusable="false"
>
  <g class="motif-scattered">
    {scattered.map((sq, i) => (
      <rect
        class="motif-float"
        x={sq.x}
        y={sq.y}
        width={sq.s}
        height={sq.s}
        style={`--r:${sq.r}deg;--dx:${sq.dx}px;--dy:${sq.dy}px;--i:${i};transform-origin:${sq.x + sq.s / 2}px ${sq.y + sq.s / 2}px;`}
      />
    ))}
  </g>
  <g class="motif-grid">
    {cells.map((c) => (
      <rect x={c.x} y={c.y} width={cell} height={cell} />
    ))}
  </g>
  <rect class="motif-fill" x={gridX + cell * 2} y={gridY + cell * 2} width={cell} height={cell} />
</svg>

<style>
  .motif {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .motif-scattered rect {
    fill: none;
    stroke: rgba(248, 250, 252, 0.38);
    stroke-width: 1.25;
    vector-effect: non-scaling-stroke;
    transform: rotate(var(--r));
  }

  .motif-grid rect {
    fill: none;
    stroke: rgba(248, 250, 252, 0.3);
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .motif-fill {
    fill: var(--teal-500);
  }

  @media (prefers-reduced-motion: no-preference) {
    .motif-anime .motif-float {
      animation: motif-settle 1100ms var(--ease) both;
      animation-delay: calc(var(--i) * 60ms);
    }

    .motif-anime .motif-fill {
      animation: motif-fill 420ms var(--ease) both;
      animation-delay: 900ms;
    }
  }

  @keyframes motif-settle {
    from {
      opacity: 0;
      transform: translate(var(--dx), var(--dy)) rotate(calc(var(--r) * 3));
    }
    to {
      opacity: 1;
      transform: translate(0, 0) rotate(var(--r));
    }
  }

  @keyframes motif-fill {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }
</style>
