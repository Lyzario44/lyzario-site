---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import PageLayout from '../../layouts/PageLayout.astro';
import MediaSlot from '../../components/MediaSlot.astro';
import { site } from '../../data/site';

export const getStaticPaths = (async () => {
  const cas = await getCollection('realisations', ({ data }) => data.draft !== true);
  return cas.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const { data } = entry;
const { Content } = await render(entry);
const url = `${site.url}/realisations/${entry.id}`;

const fiche = [
  { terme: 'Secteur', valeur: data.client.secteur },
  { terme: 'Taille', valeur: data.client.taille },
  { terme: 'Localisation', valeur: data.client.localisation },
  { terme: 'Durée', valeur: data.duree },
  { terme: 'Outils', valeur: data.outils.length ? data.outils.join(', ') : undefined },
].filter((f) => f.valeur);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: data.titre,
      description: data.metaDescription,
      datePublished: data.datePublication.toISOString(),
      author: { '@type': 'Person', name: site.founder, url: site.url },
      publisher: { '@type': 'Organization', name: site.name, url: site.url },
      mainEntityOfPage: url,
      inLanguage: 'fr-FR',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Accueil', item: site.url },
        { '@type': 'ListItem', position: 2, name: 'Réalisations', item: `${site.url}/#realisations` },
        { '@type': 'ListItem', position: 3, name: data.titre, item: url },
      ],
    },
  ],
};
---

<PageLayout title={data.metaTitle} description={data.metaDescription} label="Étude de cas" h1={data.titre} intro={data.resume} jsonLd={jsonLd}>
  <nav slot="fil" class="fil" aria-label="Fil d’Ariane">
    <ol role="list">
      <li><a href="/">Accueil</a></li>
      <li><a href="/#realisations">Réalisations</a></li>
      <li aria-current="page">{data.titre}</li>
    </ol>
  </nav>

  {
    fiche.length > 0 && (
      <dl class="fiche">
        {fiche.map((f) => (
          <div>
            <dt>{f.terme}</dt>
            <dd>{f.valeur}</dd>
          </div>
        ))}
      </dl>
    )
  }

  <h2>Le contexte</h2>
  <p>{data.contexte}</p>

  <h2>Ce qui coinçait</h2>
  <p>{data.probleme}</p>

  <h2>Ce que j’ai construit</h2>
  <Content />

  {
    data.captures.length > 0 && (
      <div class="cas-captures">
        {data.captures.map((c, i) => (
          <MediaSlot
            media={{
              id: `${entry.id}-${i}`,
              fichier: '',
              section: 'Étude de cas',
              titre: c.alt,
              consigne: '',
              ratio: '16 / 10',
              alt: c.alt,
              legende: c.legende,
              src: c.src,
            }}
            sizes="(min-width: 800px) 760px, 100vw"
          />
        ))}
      </div>
    )
  }

  {
    data.resultats.length > 0 && (
      <>
        <h2>Résultats</h2>
        <ul>
          {data.resultats.map((r) => (
            <li>
              {r.texte} <span class="nature">({r.nature === 'mesure' ? 'mesuré' : 'déclaré par le client'})</span>
            </li>
          ))}
        </ul>
      </>
    )
  }

  {
    data.temoignage && (
      <figure class="cas-temoignage">
        <blockquote>
          <p>« {data.temoignage.citation} »</p>
        </blockquote>
        <figcaption>
          {data.temoignage.auteur}, {data.temoignage.fonction}
        </figcaption>
      </figure>
    )
  }

  <p class="cas-cta">
    <a class="btn btn-primary" href={site.bookingUrl} target="_blank" rel="noopener">
      {site.ctaAudit}<span class="sr-only"> (nouvel onglet)</span>
    </a>
  </p>
</PageLayout>

<style>
  .fil ol {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-bottom: var(--space-5);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .fil li + li::before {
    content: '/';
    margin-right: var(--space-2);
    color: var(--fg-muted);
  }

  .fil a {
    color: var(--fg-soft);
    text-underline-offset: 3px;
  }

  .fiche {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: var(--space-4);
    padding: var(--space-5);
    margin-bottom: var(--space-7);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .fiche dt {
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .fiche dd {
    margin-top: var(--space-1);
    color: var(--fg);
  }

  .cas-captures {
    margin-top: var(--space-6);
    display: grid;
    gap: var(--space-5);
  }

  .nature {
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .cas-temoignage {
    margin-top: var(--space-7);
    padding: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .cas-temoignage blockquote {
    font-family: var(--font-serif);
    font-size: var(--text-display-sm);
    line-height: 1.25;
    color: var(--fg);
  }

  .cas-temoignage figcaption {
    margin-top: var(--space-4);
    font-size: var(--text-sm);
    color: var(--fg-muted);
  }

  .cas-cta {
    margin-top: var(--space-7) !important;
  }

  .cas-cta a {
    color: var(--nuit-900) !important;
    text-decoration: none;
  }
</style>
